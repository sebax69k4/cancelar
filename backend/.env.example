# Copiá este archivo a .env y ajustá los valores.

# Puerto HTTP del backend
PORT=3000

# Base de datos PostgreSQL. Reemplazá CONTRASENA por la del usuario postgres (o el que crees).
# Si la contraseña tiene caracteres especiales (@ : / # ?), escribilos codificados (ej. @ = %40).
DATABASE_URL="postgresql://postgres:CONTRASENA@localhost:5432/servicio_tecnico?schema=public"
# Opcional: base para npm run test:e2e (si falta, usa DATABASE_URL en esquemas aparte e2e_*).
# TEST_DATABASE_URL="postgresql://postgres:CONTRASENA@localhost:5432/servicio_tecnico_test"

# Origen del frontend permitido por CORS (con cookies)
CORS_ORIGIN=http://localhost:4321

# Secreto para firmar los JWT de sesión. Generá uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# Duración de la sesión
JWT_EXPIRES_IN=8h

# true en producción con HTTPS
COOKIE_SECURE=false

# Carpeta donde se guardan las evidencias subidas
UPLOAD_DIR=uploads
# Tamaño máximo por archivo de evidencia, en MB (máximo 10: no se puede subir)
UPLOAD_MAX_MB=10

# Proxies (Nginx, Caddy, balanceador) delante de la API. En producción detrás de un proxy: 1.
# Con 0 (sin proxy) la IP del cliente no se puede falsear con X-Forwarded-For.
TRUST_PROXY=0

# Zona horaria del taller: define qué es «hoy» para las fechas estimadas y el año del número
# de orden. Si falta, se usa la de Argentina (los servidores en la nube corren en UTC).
# TZ=America/Argentina/Buenos_Aires

# Primer Administrador de plataforma (Moderador y Administrador están por encima de los talleres).
# Se crea al arrancar SOLO si todavía no hay ninguna cuenta de plataforma. La clave: 12 a 40
# caracteres, con letras y números. Al ingresar en /plataforma pide configurar el segundo factor.
# Después de crearlo, borrá PLATAFORMA_ADMIN_CLAVE del entorno.
# PLATAFORMA_ADMIN_EMAIL=admin@mi-dominio.com
# PLATAFORMA_ADMIN_NOMBRE=Nombre Apellido
# PLATAFORMA_ADMIN_CLAVE=una-clave-larga-123
