---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@/styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · ServicioTécnico</title>
    <!-- Aplica estilo (clásico por defecto) y tema antes de pintar para evitar parpadeo -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          if (localStorage.getItem('st.skin') !== 'modern') root.classList.add('skin-classic');
          var p = localStorage.getItem('st.theme');
          var dark = p === 'dark' || (p !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) root.classList.add('dark');
        } catch (e) {
          root.classList.add('skin-classic');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
