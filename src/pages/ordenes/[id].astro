---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ShellFallback from '@/components/layout/ShellFallback.astro';
import OrderDetailPage from '@/components/islands/OrderDetailPage';

// id dinámico: en la demo la orden vive en localStorage, así que no se puede prerenderizar
export const prerender = false;

const id = Astro.params.id ?? '';
---

<BaseLayout title="Orden de servicio">
  <OrderDetailPage client:only="react" id={id}>
    <ShellFallback slot="fallback" />
  </OrderDetailPage>
</BaseLayout>
