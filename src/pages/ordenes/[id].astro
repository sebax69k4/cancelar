---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ShellFallback from '@/components/layout/ShellFallback.astro';
import PlaceholderPage from '@/components/islands/PlaceholderPage';
export const prerender = false; // id dinámico: la orden vive en localStorage
---

<BaseLayout title="Detalle de orden">
